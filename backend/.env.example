PORT=4000
HOST=0.0.0.0

# Supabase replaces SQLyog/MySQL. Never expose the service-role key to web or Expo.
DATABASE_PROVIDER=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
SUPABASE_PASSWORD_RESET_REDIRECT_URL=remindme://reset-password

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=remindme
MYSQL_USER=remindme_app
MYSQL_PASSWORD=replace-with-your-private-password
MYSQL_CONNECTION_LIMIT=10

# Comma-separated browser origins allowed to call the API. Leave blank only
# during local development. Expo Go does not need an Origin entry.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Use Supabase Storage.
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=remindme-uploads
